{
  "name": "pisastyle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PISA-style exam practice and study units in Spanish, English and Portuguese (SWAL).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && bash scripts/with-nix-browser.sh playwright test",
    "test:tokens": "python3 scripts/verify-swallow-tokens.py",
    "test:watch": "vitest",
    "verify:seo": "node scripts/verify-seo.mjs",
    "og:generate": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@swal/ui": "^0.2.0",
    "@swal/vault": "^0.2.0",
    "astro": "^7.3.1",
    "idb": "8.0.3",
    "y-indexeddb": "9.0.12",
    "y-webrtc": "10.3.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/svelte": "^9.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "autoprefixer": "10.5.4",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "sql.js": "^1.15.0",
    "svelte": "^5.57.0",
    "typescript": "^5.9.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "4.1.11"
  }
}
