---
import { Toaster } from '@swal/ui';
import { PISASTYLE_DEFAULT_LOCALE, type PisaLocale } from '../lib/pisa-i18n';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title?: string;
  description?: string;
  /** Locale explicito de la ruta (/es|en|pt/...). Si no viene, se usa el que
   *  resolvio el middleware (Accept-Language, cookie, ?lang=). */
  locale?: PisaLocale;
  /** URLs alternas para hreflang. Sin esto Google no indexa las 3 locales
   *  como la misma pagina en distintos idiomas, sino 3 paginas duplicadas. */
  alternates?: Record<string, string>;
  /** Ruta sin locale, para marcar el enlace activo del menu. */
  current?: string;
  /** Oculta la barra de navegacion (404/500, donde no hay destino util). */
  hideNav?: boolean;
}
const {
  title = 'PISAStyle by SWAL — Preparación PISA',
  description = 'Matemáticas, Lectura, Ciencias y Mundo Digital. Contenido educativo no oficial, sin afiliación con la OECD.',
  // El `as PisaLocale` es necesario: Astro.locals.pisaLocale es `any` y sin
  // el cast el default ensancha `locale` a string, que ya no es asignable
  // al prop de SiteNav.
  locale = (Astro.locals.pisaLocale ?? PISASTYLE_DEFAULT_LOCALE) as PisaLocale,
  alternates,
  current = '',
  hideNav = false,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {alternates && Object.entries(alternates).map(([lang, href]) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
    <link rel="manifest" href="/manifest.json" /><meta name="theme-color" content="#121211" />
  </head>
  <body>
    {/* Navegacion global. Va aqui y no en cada pagina para que las cuatro la
        tengan sin repetir markup ni olvidarla: sin esto el usuario aterriza en
        Explorar sin ninguna salida visible. */}
    {hideNav ? null : <SiteNav locale={locale} current={current} />}
    <slot />
    <Toaster client:load />

    {/* CSS de los componentes de @swal/ui.
        Antes esto no se podia hacer y la app llevaba parches propios: el core
        no exportaba su CSS, solo los TOKENS (que son variables, no estilos),
        asi que node_modules/@swal/ui/dist/ui.css no existia en ninguna app. Los
        componentes Svelte usados sin `client:*` salian con sus clases
        correctas pero con CERO reglas que las aplicaran (boton 133x21, Times
        New Roman, padding 1px 6px).

        Arreglado en el core (2026-10-03): `exports['./ui.css']` y `dist` en
        `files`. Por eso ahora basta con importar la hoja del paquete, sin
        generar nada ni compilar los .svelte a mano.
        https://github.com/iberi22/swal-ui */}

    <style is:global>
      @import '@swal/ui/tokens';
      /* Estilos de los componentes (hoja de entrada que exporta el core) */
      @import '@swal/ui/ui.css';
      /* Capa semantica PISAStyle (series Okabe-Ito accesibles) — DESPUES del
         core para que pueda mapear sobre `--swal-*`. Ver src/styles/pisa-tokens.css */
      @import '../styles/pisa-tokens.css';
      html { background: var(--swal-bg); color: var(--swal-text); }
      body { margin: 0; font-family: var(--swal-font); -webkit-font-smoothing: antialiased; }
    </style>
  </body>
</html>