---
import { Toaster } from '@swal/ui';
import { PISASTYLE_DEFAULT_LOCALE, type PisaLocale } from '../lib/pisa-i18n';
import swalUiComponentsCss from '../styles/swal-ui-components.css?raw';

interface Props {
  title?: string;
  description?: string;
  /** Locale explicito de la ruta (/es|en|pt/...). Si no viene, se usa el que
   *  resolvio el middleware (Accept-Language, cookie, ?lang=). */
  locale?: PisaLocale;
  /** URLs alternas para hreflang. Sin esto Google no indexa las 3 locales
   *  como la misma pagina en distintos idiomas, sino 3 paginas duplicadas. */
  alternates?: Record<string, string>;
}
const {
  title = 'PISAStyle by SWAL — Preparación PISA',
  description = 'Matemáticas, Lectura, Ciencias y Mundo Digital. Contenido educativo no oficial, sin afiliación con la OECD.',
  locale = Astro.locals.pisaLocale ?? PISASTYLE_DEFAULT_LOCALE,
  alternates,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {alternates && Object.entries(alternates).map(([lang, href]) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
    <link rel="manifest" href="/manifest.json" /><meta name="theme-color" content="#121211" />
  </head>
  <body>
    <slot />
    <Toaster client:load />

    {/* CSS de los componentes Svelte de @swal/ui — SOLO en dev.
        En `astro dev` Vite externaliza @swal/ui en SSR: sus .svelte no pasan por
        el pipeline de Svelte, asi que su CSS scoped nunca entra en el grafo y
        no se inyecta. Las clases llegan correctas al DOM pero CERO reglas las
        aplican, y <Button> se ve como un boton nativo del navegador (133x21,
        Times, padding 1px 6px) en vez del del design system. En `astro build`
        Vite ya emite estas mismas reglas, asi que incluirlas ahi solo duplicaria
        CSS en el bundle (medido: Layout.css 16.7KB -> 24.1KB).

        El fichero lo genera `scripts/generate-swal-ui-css.mjs` compilando los
        .svelte del CORE con el mismo `filename` que usa Vite, de modo que el
        hash `svelte-*` coincide con el del HTML ya emitido. No se transcriben
        estilos: un retoque en el core se refleja al regenerar. */}
    {import.meta.env.DEV && <style is:global set:html={swalUiComponentsCss} />}

    <style is:global>
      @import '@swal/ui/tokens';
      /* Capa semantica PISAStyle (series Okabe-Ito accesibles) — DESPUES del
         core para que pueda mapear sobre `--swal-*`. Ver src/styles/pisa-tokens.css */
      @import '../styles/pisa-tokens.css';
      html { background: var(--swal-bg); color: var(--swal-text); }
      body { margin: 0; font-family: var(--swal-font); -webkit-font-smoothing: antialiased; }
    </style>
  </body>
</html>