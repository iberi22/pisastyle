---
/**
 * Autoevaluación — "¿en qué nivel estoy?"
 *
 * Por qué existe: el modelo ya declara la entidad `exam_attempt`
 * (src/lib/domain.config.ts) pero NADA la consumía — cero usos en UI
 * (verificado 2026-10-03 con grep sobre src/pages/**). Y el FAQ propio explica
 * la escala de niveles ("nivel 2 como competencia mínima"), así que la app
 * describe el sistema y luego no deja que nadie se situe en él. Esta página
 * cierra ese hueco.
 *
 * Alcance deliberado: ORIENTATIVO, no un examen PISA. Quince preguntas, cinco por
 * dominio, y devuelve el nivel de desempeño más cercano según los cortes reales
 * del Protocolo v1.1 §3. No es un ítem liberado ni predice resultados, y la
 * página lo dice.
 *
 * Sin JS de framework: <form> nativo con GET y un <fieldset> por dominio. Con
 * output:'server' el resultado se renderiza en el servidor: sin hidratación y
 * sin bundle de cliente. Es lo que un producto educativo necesita — se puede
 * compartir por URL y funciona sin JS.
 */
import Layout from '../../layouts/Layout.astro';

import { buildAlternates, routeLocale } from '../../lib/alternates';
import { isPisaLocale } from '../../lib/pisa-i18n';
import { EXAM_ITEMS, examByDomain, type ExamItem } from '../../lib/exam-items';
import { levelForCorrectCount } from '../../lib/evaluation-store';

export function getStaticPaths() {
  return [
    { params: { locale: 'es' } },
    { params: { locale: 'en' } },
    { params: { locale: 'pt' } },
  ];
}

const { locale } = Astro.params;

// Un primer segmento que no es locale NO es una ruta del sitio. Sin esta
// comprobacion, `[locale]` hace match con cualquier cosa (/xx) y la pagina se
// sirve con la locale por defecto bajo una URL canonica que no existe: un 200
// falso, que es lo peor que puede tener un sitio que los agentes indexan.
if (!isPisaLocale(locale)) {
  return Astro.redirect('/404');
}
const loc = routeLocale(locale);

/**
 * Aciertos (0-5) -> nivel de desempeño estimado.
 *
 * NO son los cortes numéricos del Protocolo v1.1 §3 (233-607): esos están en
 * escala PISA y no aplican a un test de 5 preguntas. Mapear 5/5 sobre 607 daba
 * nivel 1c, que es absurdo. Esta tabla es una estimación orientativa, no un
 * dato oficial, y la página lo dice.
 *
 * Mapeo directo y no interpolación: 6 resultados posibles y 6 niveles es
 * exactamente lo que cabe sin fingir precisión.
 */

/** Tono del chip por número de aciertos. Índices alineados con LEVEL_BY_SCORE. */
const TONE_BY_SCORE = ['low', 'low', 'mid', 'mid', 'good', 'top'] as const;


type DomainKey = 'math' | 'reading' | 'science';
type Option = string;
/** enunciado, 4 opciones barajadas, indice de la correcta dentro de ellas. */
type Question = readonly [string, Option[], number];

interface Copy {
  title: string;
  intro: string;
  domains: Record<DomainKey, string>;
  scaleLabel: string;
  scoreLabel: string;
  submit: string;
  reset: string;
  prevNotice: string;
  resultHeading: string;
  resultNote: string;
}

const COPY: Record<'es' | 'en' | 'pt', Copy> = {
  es: {
    title: 'Evalúa tu nivel de PISA',
    intro:
      'Quince preguntas orientativas. Al final obtendrás una estimación del nivel de ' +
      'desempeño en cada dominio. No es un examen PISA ni una predicción de ' +
      'resultado: sirve para saber por dónde empezar.',
    domains: { math: 'Matemáticas', reading: 'Lectura', science: 'Ciencias' },
    scaleLabel: 'Nivel estimado',
    scoreLabel: 'correctas',
    submit: 'Ver mi nivel',
    reset: 'Empezar de nuevo',
    prevNotice: 'Tu última evaluación guardada:',
    resultHeading: 'Tu estimación',
    resultNote:
      'Escala orientativa propia: los cortes numéricos del Protocolo PISAStyle ' +
      'v1.1 §3 (233-607) están en escala PISA y no aplican a 5 preguntas. ' +
      'Una estimación no sustituye una evaluación oficial.',
  },
  en: {
    title: 'Check your PISA level',
    intro:
      'Fifteen orientative questions. You will get an estimate of the performance ' +
      'level you would reach in each domain. This is not a PISA exam nor a result ' +
      'prediction: it tells you where to start.',
    domains: { math: 'Mathematics', reading: 'Reading', science: 'Science' },
    scaleLabel: 'Estimated level',
    scoreLabel: 'correct',
    submit: 'See my level',
    reset: 'Start over',
    prevNotice: 'Your last saved evaluation:',
    resultHeading: 'Your estimate',
    resultNote:
      'Own orientative scale: the numeric cuts in PISAStyle Protocol v1.1 §3 ' +
      '(233-607) are on the PISA scale and do not apply to 5 questions. An ' +
      'estimate does not replace an official assessment.',
  },
  pt: {
    title: 'Avalie seu nível PISA',
    intro:
      'Quinze questões orientativas. Ao final você obtém uma estimativa do nível de ' +
      'desempenho em cada domínio. Não é uma prova PISA nem previsão de ' +
      'resultado: serve para saber por onde começar.',
    domains: { math: 'Matemática', reading: 'Leitura', science: 'Ciências' },
    scaleLabel: 'Nível estimado',
    scoreLabel: 'corretas',
    submit: 'Ver meu nível',
    reset: 'Começar de novo',
    prevNotice: 'Sua última avaliação guardada:',
    resultHeading: 'Sua estimativa',
    resultNote:
      'Escala orientativa própria: os cortes numéricos do Protocolo PISAStyle ' +
      'v1.1 §3 (233-607) estão na escala PISA e não se aplicam a 5 questões. ' +
      'Uma estimativa não substitui uma avaliação oficial.',
  },
};

const L = COPY[loc];
// Las preguntas viven en src/lib/exam-items.ts, no en esta pagina. La pagina
// solo aporta el copy por locale; los datos son una fuente unica y estan
// verificados por calculo real en evaluar-items.test.ts y por fingerprint en
// exam-items.test.ts.
const ITEMS = EXAM_ITEMS[loc as 'es' | 'en' | 'pt'] ?? EXAM_ITEMS.en;
const BY_DOMAIN = examByDomain(ITEMS);

const GROUPS: { key: DomainKey; qs: ExamItem[] }[] = [
  { key: 'math', qs: BY_DOMAIN.math },
  { key: 'reading', qs: BY_DOMAIN.reading },
  { key: 'science', qs: BY_DOMAIN.science },
];

// Envío por GET: sin estado, compartible por URL y funciona sin JS.
const submitted = Astro.url.searchParams.has('enviar');

interface Result { key: DomainKey; label: string; correct: number; level: string; tone: string }
const results: Result[] = [];

if (submitted) {
  for (const g of GROUPS) {
    let correct = 0;
    g.qs.forEach((q, i) => {
      // Se compara el INDICE, no el texto: por texto fallaria si una opcion
      // coincidiera con el valor de otra, y obliga a que la baraja de
      // src/lib/exam-items.ts sea la unica fuente de verdad.
      const elegido = Astro.url.searchParams.get(`${g.key}${i}`);
      if (elegido !== null && Number(elegido) === q.correctIndex) correct += 1;
    });
    // El numero de aciertos (0..5) es a la vez la clave de LEVEL_BY_SCORE y de
    // TONE_BY_SCORE: no hace falta una segunda conversion.
    results.push({
      key: g.key,
      label: L.domains[g.key],
      correct,
      level: levelForCorrectCount(correct),
      tone: TONE_BY_SCORE[correct],
    });
  }
}
---

<Layout
  title={L.title}
  locale={loc}
  current="evaluar"
  alternates={buildAlternates({ path: 'evaluar', locale, site: Astro.site })}
>
  <main class="wrap">
    <h1>{L.title}</h1>
    <p class="intro">{L.intro}</p>

    {results.length > 0 && (
      <section class="results" aria-live="polite">
        <h2>{L.resultHeading}</h2>
        <ul class="result-list">
          {results.map((r) => (
            <li class="result" data-domain={r.key}>
              <span class="result-domain">{r.label}</span>
              <span class="result-score">{r.correct}/5 {L.scoreLabel}</span>
              <span class={`level-chip tone-${r.tone}`}>
                {L.scaleLabel} <strong>{r.level}</strong>
              </span>
            </li>
          ))}
        </ul>
        <p class="note">{L.resultNote}</p>
        <a class="reset" href={`/${loc}/evaluar`}>{L.reset}</a>
      </section>
    )}

    <form method="get" action={`/${loc}/evaluar`} class="quiz">
      <input type="hidden" name="enviar" value="1" />
      {GROUPS.map((g) => (
        <fieldset class="domain">
          <legend>{L.domains[g.key]}</legend>
          {g.qs.map((q, i) => (
            <div class="q" data-domain={g.key} data-correct={q.correctIndex}>
              <p class="q-text">{q.stem}</p>
              <div class="options" role="group" aria-label={q.stem}>
                {q.options.map((opt: string, oi: number) => (
                  <label class="option">
                    <input type="radio" name={`${g.key}${i}`} value={oi} required />
                    <span>{opt}</span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </fieldset>
      ))}
      <button type="submit" class="submit">{L.submit}</button>
    </form>
  </main>
{/* Persistencia del resultado. El formulario es SSR con GET, asi que sin esto
    recargar pierde la estimacion: la app no recordaria nada del visitante.
    Solo se guarda el agregado (nivel y aciertos por dominio) — nunca las
    respuestas ni los enunciados, que son contenido privado (LICENSE.md p2).
    Ver src/lib/evaluation-store.ts, con sus tests. */}
{/* Config del script en un <script type="application/json">, no con
    define:vars: define:vars inyecta una variable que TypeScript no puede ver
    (warning ts(2570)) y obliga a duplicar el nombre. Leyendo del DOM el
    check queda limpio y los datos siguen siendo JSON, no codigo. */}
{/* Config en atributos data-, no en un <script type="application/json"> ni con
    define:vars. Los dos jalan problemas distintos: define:vars inyecta una
    variable que TypeScript no ve (ts(2570)), y el data-tag hace que Astro
    tipifique el script siguiente (ts(7053) por los objects sin indice). Un
    <div data-...> es HTML normal: sin tipos, sin bundling, sin hydration. */}
<div
  hidden
  id="eval-config"
  data-key="pisastyle:evaluacion"
  data-loc={routeLocale(locale)}
  data-notice={L.prevNotice}
/>
<script is:inline>
  (function () {
    var el = document.getElementById('eval-config');
    if (!el) return;
    var KEY = el.getAttribute('data-key');
    var LOC = el.getAttribute('data-loc');
    var NOTICE = el.getAttribute('data-notice') || '';

    function read() {
      try { var raw = localStorage.getItem(KEY); return raw ? JSON.parse(raw) : {}; }
      catch (e) { return {}; }
    }
    function write(obj) {
      try { localStorage.setItem(KEY, JSON.stringify(obj)); } catch (e) { /* cuota */ }
    }

    // Al enviar: guarda SOLO el agregado (nivel y aciertos por dominio).
    // Nunca las respuestas ni los enunciados: son contenido privado.
    var form = document.querySelector('form.quiz');
    if (form) {
      /* Se guarda alEnviar se persistía vacío: el submit navega por GET y el
         listener corre ANTES de que la página nueva llegue a renderizar sus
         .result — no habia nada que leer. Por eso se guarda al cargar la
         pagina de resultados, que es donde el DOM ya existe. */
      form.addEventListener('submit', function () {
        try { sessionStorage.setItem('pisastyle:pendiente', '1'); } catch (e) {}
      });
    }

    function guardar() {
      var out = read();
        var levels = {};
        var scores = {};
        var rows = document.querySelectorAll('.result');
        for (var i = 0; i < rows.length; i++) {
          var row = rows[i];
          var dom = (row.getAttribute('data-domain') || '').trim();
          if (!dom) continue;
          var chip = row.querySelector('.level-chip');
          var score = row.querySelector('.result-score');
          /* El chip dice "Nivel 2" (con &nbsp;). Se quedaban los ultimos 2
             caracteres ALFABETICOS y salia "o2" (la "o" de Nivel). Se extrae el
             numero con un patron, no recortando. */
          if (chip) {
            var lm = (chip.textContent || '').match(/(\d+[a-z]?)/i);
            if (lm) levels[dom] = lm[1];
          }
          if (score) {
            var m = (score.textContent || '').match(/(\d+)\s*\/\s*5/);
            if (m) scores[dom] = Number(m[1]);
          }
        }
      out[LOC] = { levels: levels, scores: scores, at: new Date().toISOString() };
      write(out);
    }

    // Si esta pagina YA trae resultados (viene por URL con ?enviar=1), se guarda.
    if (document.querySelector('.results')) guardar();

    // Al volver sin resultados en la URL: repone el ultimo guardado.
    if (!document.querySelector('.results')) {
      var prev = read()[LOC];
      if (prev && prev.levels) {
        var note = document.createElement('p');
        note.className = 'prev-result';
        /* Fecha en formato largo y sin ambiguedad: `toLocaleDateString` corto
           daba 4/10/2026, que se lee como dia/mes en es y como mes/dia en en.
           Con year/month/day largos es 4 de octubre de 2026 en las tres. */
        var when = prev.at
          ? new Date(prev.at).toLocaleDateString(LOC, {
              year: 'numeric', month: 'long', day: 'numeric',
            })
          : '';
        note.textContent = NOTICE + (when ? ' (' + when + ')' : '');
        /* Se insertaba con insertBefore(note, main.firstChild.nextSibling).
           main.firstChild es el <h1>, asi que la referencia caia en un nodo de
           texto posterior y el aviso NO aparecia (medido: localStorage con el
           resultado, .results ausente, sin .prev-result). Se usa insertBefore
           sobre el hijo SIGUIENTE real del h1: null significa "al principio",
           que es justo donde queremos el aviso. */
        var main = document.querySelector('main.wrap');
        var h1 = main ? main.querySelector('h1') : null;
        if (main && h1) main.insertBefore(note, h1.nextElementSibling);
      }
    }
  })();
</script>
<script>
  import { writeResult, levelForCorrectCount, countCorrect, type DomainKey } from '../../lib/evaluation-store';
  import type { PisaLocale } from '../../lib/pisa-i18n';

  const form = document.querySelector('form.quiz') as HTMLFormElement;
  const mainWrap = document.querySelector('main.wrap') as HTMLElement;
  const configEl = document.getElementById('eval-config') as HTMLElement;

  if (form && mainWrap && configEl) {
    const loc = configEl.getAttribute('data-loc') as PisaLocale;
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const levels: Partial<Record<DomainKey, string>> = {};
      const scores: Partial<Record<DomainKey, number>> = {};
      const domains: DomainKey[] = ['math', 'reading', 'science'];

      const formData = new FormData(form);

      domains.forEach(d => {
        const qs = Array.from(form.querySelectorAll(`.q[data-domain="${d}"]`));
        if (!qs.length) return;

        const correctIndexes = qs.map(q => Number(q.getAttribute('data-correct')));
        const chosen = qs.map((_, i) => {
          const val = formData.get(`${d}${i}`);
          return val !== null ? Number(val) : null;
        });

        const correct = countCorrect(correctIndexes, chosen);
        scores[d] = correct;
        levels[d] = levelForCorrectCount(correct);
      });

      writeResult(loc, { levels, scores });

      let res = document.querySelector('section.results');
      if (!res) {
        res = document.createElement('section');
        res.className = 'results';
        res.innerHTML = '<ul class="result-list"></ul>';
        form.parentNode?.insertBefore(res, form);
      }
      const ul = res.querySelector('.result-list');
      if (ul) {
        ul.innerHTML = '';
        domains.forEach(d => {
          if (scores[d] !== undefined) {
            ul.insertAdjacentHTML('beforeend', `<li class="result" data-domain="${d}">
              <span class="result-domain">${d}</span>
              <span class="result-score">${scores[d]}/5</span>
              <span class="level-chip tone-mid">Nivel <strong>${levels[d]}</strong></span>
            </li>`);
          }
        });
      }
      res.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>
</Layout>

<style>
  .wrap { max-width: 780px; margin: 0 auto; padding: 1.5rem 1rem 3rem; display: grid; gap: 1.25rem; }
  h1 { font-size: 1.8rem; font-weight: 800; color: var(--swal-text); margin: 0; letter-spacing: -0.02em; }
  .intro { color: var(--swal-text-secondary); margin: 0; line-height: 1.6; }
  fieldset { border: 1px solid var(--swal-border); border-radius: 10px; padding: 1rem 1.1rem; margin: 0; background: var(--swal-surface); }
  /* El <legend> se sentaba pegado al borde superior del fieldset (vision lo
     marco como superposicion). Con margin-bottom queda dentro del recuadro. */
  legend { padding: 0 0.4rem; font-weight: 700; color: var(--swal-text); margin-bottom: 0.35rem; }
  .q { padding: 0.6rem 0; border-top: 1px solid var(--swal-border); }
  .q:first-of-type { border-top: 0; }
  .q-text { margin: 0 0 0.5rem; color: var(--swal-text); line-height: 1.5; }
  .options { display: grid; gap: 0.35rem; }
  .option { display: flex; align-items: center; gap: 0.5rem; min-height: 2.25rem; padding: 0.3rem 0.45rem; border-radius: 6px; cursor: pointer; color: var(--swal-text-secondary); }
  .option:hover { background: var(--swal-surface-hover); color: var(--swal-text); }
  .option input { accent-color: var(--swal-accent); width: 1rem; height: 1rem; flex: none; }
  .option:focus-within { outline: 2px solid var(--swal-accent); outline-offset: 2px; }
  .submit {
    justify-self: start; min-height: 2.5rem; padding: 0 1.25rem; border: 0;
    border-radius: 8px; background: var(--swal-accent);
    color: var(--swal-accent-contrast, var(--swal-bg));
    font-weight: 600; font-size: 0.95rem; cursor: pointer;
  }
  .submit:hover { background: var(--swal-accent-hover); }
  .results { background: var(--swal-surface); border: 1px solid var(--swal-border); border-radius: 10px; padding: 1rem 1.1rem; }
  .results h2 { margin: 0 0 0.6rem; font-size: 1.15rem; color: var(--swal-text); }
  /* El aviso lo CREA el script en runtime, asi que el elemento no lleva el
     data-astro-cid que Astro añade a los estaticos: un selector normal
     (.prev-result) se compila a .prev-result[data-astro-cid-...] y no casaba
     con nada — salia con fondo transparente, sin borde y a 16px. :global()
     deja el selector sin scope para que aplique al elemento inyectado. */
  :global(.prev-result) {
    margin: 0; padding: 0.6rem 0.9rem; font-size: 0.85rem; line-height: 1.5;
    color: var(--swal-text-secondary); background: var(--swal-surface);
    border: 1px solid var(--swal-border); border-left: 3px solid var(--swal-accent);
    border-radius: 8px;
  }
  .result-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .result { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .result-domain { font-weight: 600; color: var(--swal-text); min-width: 7rem; }
  .result-score { color: var(--swal-text-secondary); font-size: 0.85rem; }
  .level-chip {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.2rem 0.6rem; border-radius: 9999px;
    font-size: 0.78rem; font-weight: 600;
    border: 1px solid transparent; white-space: nowrap;
  }
  .tone-low  { background: var(--swal-danger-muted,  rgba(239,68,68,.12));  color: var(--swal-danger);  border-color: var(--swal-danger-border,  rgba(239,68,68,.25)); }
  .tone-mid  { background: var(--swal-warning-muted, rgba(245,158,11,.12)); color: var(--swal-warning); border-color: var(--swal-warning-border, rgba(245,158,11,.25)); }
  .tone-good { background: var(--swal-info-muted,    rgba(6,182,212,.12));  color: var(--swal-info);    border-color: var(--swal-info-border,    rgba(6,182,212,.25)); }
  .tone-top  { background: var(--swal-success-muted, rgba(16,185,129,.12)); color: var(--swal-success); border-color: var(--swal-success-border, rgba(16,185,129,.25)); }
  .level-chip strong { font-weight: 800; }
  .note { font-size: 0.8rem; color: var(--swal-text-muted); line-height: 1.5; margin: 0.75rem 0 0; }
  .reset { display: inline-flex; align-items: center; min-height: 2.25rem; margin-top: 0.6rem; font-size: 0.85rem; color: var(--swal-text-secondary); }
  .reset:hover { color: var(--swal-text); }
  @media (max-width: 640px) {
    .result { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    .result-domain { min-width: 0; }
  }
</style>