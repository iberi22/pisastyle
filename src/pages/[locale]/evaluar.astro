};

const L = COPY[loc];
const GROUPS: { key: DomainKey; qs: Question[] }[] = [
  { key: 'math', qs: L.questions.math },
  { key: 'reading', qs: L.questions.reading },
  { key: 'science', qs: L.questions.science },
];

// Envío por GET: sin estado, compartible por URL y funciona sin JS.
const submitted = Astro.url.searchParams.has('enviar');

interface Result { key: DomainKey; label: string; correct: number; level: string; tone: string }
const results: Result[] = [];

if (submitted) {
  for (const g of GROUPS) {
    let correct = 0;
    g.qs.forEach((q, i) => {
      // q = [enunciado, opciones, indiceCorrecta]. Se compara el indice: por
      // texto fallaria si una opcion coincidiera con el valor de otra, y obliga
      // a que la baraja sea la unica fuente de verdad.
      const elegido = Astro.url.searchParams.get(`${g.key}${i}`);
      if (elegido !== null && Number(elegido) === q[2]) correct += 1;
    });
    // El numero de aciertos (0..5) es a la vez la clave de LEVEL_BY_SCORE y de
    // TONE_BY_SCORE: no hace falta una segunda conversion.
    results.push({
      key: g.key,
      label: L.domains[g.key],
      correct,
      level: LEVEL_BY_SCORE[correct],
      tone: TONE_BY_SCORE[correct],
    });
  }
}
---

<Layout
  title={L.title}
  locale={loc}
  current="evaluar"
  alternates={buildAlternates({ path: 'evaluar', locale, site: Astro.site })}
>
  <main class="wrap">
    <h1>{L.title}</h1>
    <p class="intro">{L.intro}</p>

    {results.length > 0 && (
      <section class="results" aria-live="polite">
        <h2>{L.resultHeading}</h2>
        <ul class="result-list">
          {results.map((r) => (
            <li class="result" data-domain={r.key}>
              <span class="result-domain">{r.label}</span>
              <span class="result-score">{r.correct}/5 {L.scoreLabel}</span>
              <span class={`level-chip tone-${r.tone}`}>
                {L.scaleLabel} <strong>{r.level}</strong>
              </span>
            </li>
          ))}
        </ul>
        <p class="note">{L.resultNote}</p>
        <a class="reset" href={`/${loc}/evaluar`}>{L.reset}</a>
      </section>
    )}

    <form method="get" action={`/${loc}/evaluar`} class="quiz">
      <input type="hidden" name="enviar" value="1" />
      {GROUPS.map((g) => (
        <fieldset class="domain">
          <legend>{L.domains[g.key]}</legend>
          {g.qs.map((q, i) => (
            <div class="q">
              <p class="q-text">{q[0]}</p>
              <div class="options" role="group" aria-label={q[0]}>
                {q[1].map((opt, oi) => (
                  <label class="option">
                    <input type="radio" name={`${g.key}${i}`} value={oi} required />
                    <span>{opt}</span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </fieldset>
      ))}
      <button type="submit" class="submit">{L.submit}</button>
    </form>
  </main>
{/* Persistencia del resultado. El formulario es SSR con GET, asi que sin esto
    recargar pierde la estimacion: la app no recordaria nada del visitante.
    Solo se guarda el agregado (nivel y aciertos por dominio) — nunca las
    respuestas ni los enunciados, que son contenido privado (LICENSE.md p2).
    Ver src/lib/evaluation-store.ts, con sus tests. */}
{/* Config del script en un <script type="application/json">, no con
    define:vars: define:vars inyecta una variable que TypeScript no puede ver
    (warning ts(2570)) y obliga a duplicar el nombre. Leyendo del DOM el
    check queda limpio y los datos siguen siendo JSON, no codigo. */}
{/* Config en atributos data-, no en un <script type="application/json"> ni con
    define:vars. Los dos jalan problemas distintos: define:vars inyecta una
    variable que TypeScript no ve (ts(2570)), y el data-tag hace que Astro
    tipifique el script siguiente (ts(7053) por los objects sin indice). Un
    <div data-...> es HTML normal: sin tipos, sin bundling, sin hydration. */}
<div
  hidden
  id="eval-config"
  data-key="pisastyle:evaluacion"
  data-loc={routeLocale(locale)}
  data-notice={L.prevNotice}
/>
<script is:inline>
  (function () {
    var el = document.getElementById('eval-config');
    if (!el) return;
    var KEY = el.getAttribute('data-key');
    var LOC = el.getAttribute('data-loc');
    var NOTICE = el.getAttribute('data-notice') || '';

    function read() {
      try { var raw = localStorage.getItem(KEY); return raw ? JSON.parse(raw) : {}; }
      catch (e) { return {}; }
    }
    function write(obj) {
      try { localStorage.setItem(KEY, JSON.stringify(obj)); } catch (e) { /* cuota */ }
    }

    // Al enviar: guarda SOLO el agregado (nivel y aciertos por dominio).
    // Nunca las respuestas ni los enunciados: son contenido privado.
    var form = document.querySelector('form.quiz');
    if (form) {
      /* Se guarda alEnviar se persistía vacío: el submit navega por GET y el
         listener corre ANTES de que la página nueva llegue a renderizar sus
         .result — no habia nada que leer. Por eso se guarda al cargar la
         pagina de resultados, que es donde el DOM ya existe. */
      form.addEventListener('submit', function () {
        try { sessionStorage.setItem('pisastyle:pendiente', '1'); } catch (e) {}
      });
    }

    function guardar() {
      var out = read();
        var levels = {};
        var scores = {};
        var rows = document.querySelectorAll('.result');
        for (var i = 0; i < rows.length; i++) {
          var row = rows[i];
          var dom = (row.getAttribute('data-domain') || '').trim();
          if (!dom) continue;
          var chip = row.querySelector('.level-chip');
          var score = row.querySelector('.result-score');
          /* El chip dice "Nivel 2" (con &nbsp;). Se quedaban los ultimos 2
             caracteres ALFABETICOS y salia "o2" (la "o" de Nivel). Se extrae el
             numero con un patron, no recortando. */
          if (chip) {
            var lm = (chip.textContent || '').match(/(\d+[a-z]?)/i);
            if (lm) levels[dom] = lm[1];
          }
          if (score) {
            var m = (score.textContent || '').match(/(\d+)\s*\/\s*5/);
            if (m) scores[dom] = Number(m[1]);
          }
        }
      out[LOC] = { levels: levels, scores: scores, at: new Date().toISOString() };
      write(out);
    }

    // Si esta pagina YA trae resultados (viene por URL con ?enviar=1), se guarda.
    if (document.querySelector('.results')) guardar();

    // Al volver sin resultados en la URL: repone el ultimo guardado.
    if (!document.querySelector('.results')) {
      var prev = read()[LOC];
      if (prev && prev.levels) {
        var note = document.createElement('p');
        note.className = 'prev-result';
        /* Fecha en formato largo y sin ambiguedad: `toLocaleDateString` corto
           daba 4/10/2026, que se lee como dia/mes en es y como mes/dia en en.
           Con year/month/day largos es 4 de octubre de 2026 en las tres. */
        var when = prev.at
          ? new Date(prev.at).toLocaleDateString(LOC, {
              year: 'numeric', month: 'long', day: 'numeric',
            })
          : '';
        note.textContent = NOTICE + (when ? ' (' + when + ')' : '');
        /* Se insertaba con insertBefore(note, main.firstChild.nextSibling).
           main.firstChild es el <h1>, asi que la referencia caia en un nodo de
           texto posterior y el aviso NO aparecia (medido: localStorage con el
           resultado, .results ausente, sin .prev-result). Se usa insertBefore
           sobre el hijo SIGUIENTE real del h1: null significa "al principio",
           que es justo donde queremos el aviso. */
        var main = document.querySelector('main.wrap');
        var h1 = main ? main.querySelector('h1') : null;
        if (main && h1) main.insertBefore(note, h1.nextElementSibling);
      }
    }
  })();
</script>
</Layout>

<style>
  .wrap { max-width: 780px; margin: 0 auto; padding: 1.5rem 1rem 3rem; display: grid; gap: 1.25rem; }
  h1 { font-size: 1.8rem; font-weight: 800; color: var(--swal-text); margin: 0; letter-spacing: -0.02em; }
  .intro { color: var(--swal-text-secondary); margin: 0; line-height: 1.6; }
  fieldset { border: 1px solid var(--swal-border); border-radius: 10px; padding: 1rem 1.1rem; margin: 0; background: var(--swal-surface); }
  /* El <legend> se sentaba pegado al borde superior del fieldset (vision lo
     marco como superposicion). Con margin-bottom queda dentro del recuadro. */
  legend { padding: 0 0.4rem; font-weight: 700; color: var(--swal-text); margin-bottom: 0.35rem; }
  .q { padding: 0.6rem 0; border-top: 1px solid var(--swal-border); }
  .q:first-of-type { border-top: 0; }
  .q-text { margin: 0 0 0.5rem; color: var(--swal-text); line-height: 1.5; }
  .options { display: grid; gap: 0.35rem; }
  .option { display: flex; align-items: center; gap: 0.5rem; min-height: 2.25rem; padding: 0.3rem 0.45rem; border-radius: 6px; cursor: pointer; color: var(--swal-text-secondary); }
  .option:hover { background: var(--swal-surface-hover); color: var(--swal-text); }
  .option input { accent-color: var(--swal-accent); width: 1rem; height: 1rem; flex: none; }
  .option:focus-within { outline: 2px solid var(--swal-accent); outline-offset: 2px; }
  .submit {
    justify-self: start; min-height: 2.5rem; padding: 0 1.25rem; border: 0;
    border-radius: 8px; background: var(--swal-accent);
    color: var(--swal-accent-contrast, var(--swal-bg));
    font-weight: 600; font-size: 0.95rem; cursor: pointer;
  }
  .submit:hover { background: var(--swal-accent-hover); }
  .results { background: var(--swal-surface); border: 1px solid var(--swal-border); border-radius: 10px; padding: 1rem 1.1rem; }
  .results h2 { margin: 0 0 0.6rem; font-size: 1.15rem; color: var(--swal-text); }
  /* El aviso lo CREA el script en runtime, asi que el elemento no lleva el
     data-astro-cid que Astro añade a los estaticos: un selector normal
     (.prev-result) se compila a .prev-result[data-astro-cid-...] y no casaba
     con nada — salia con fondo transparente, sin borde y a 16px. :global()
     deja el selector sin scope para que aplique al elemento inyectado. */
  :global(.prev-result) {
    margin: 0; padding: 0.6rem 0.9rem; font-size: 0.85rem; line-height: 1.5;
    color: var(--swal-text-secondary); background: var(--swal-surface);
    border: 1px solid var(--swal-border); border-left: 3px solid var(--swal-accent);
    border-radius: 8px;
  }
  .result-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
