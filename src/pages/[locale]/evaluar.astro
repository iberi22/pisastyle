        ['Uma piscina leva 4 h para encher com uma mangueira. Com duas iguais?', ['8 h', '3 h', '4 h', '2 h'], 3],
        ['No mapa 1 cm representa 50 km. Que distância real são 7 cm?', ['500 km', '350 km', '700 km', '150 km'], 1],
        ['Uma turma de 30 tem 18 meninas. Que percentual são meninas?', ['50 %', '80 %', '70 %', '60 %'], 3],
      ],
      reading: [
        ['Leia: "O relatório aponta que a cidade cresceu 12 % em dois anos." Qual afirmação decorre?', ['A cidade perdeu 12 %', 'A cidade cresceu 12 % em dois anos', 'Cresceu 100 %', 'Não é possível saber'], 1],
        ['O texto diz "apesar da chuva, a feira prosseguiu". A palavra que marca o contraste é:', ['prosseguiu', 'feira', 'apesar', 'da chuva'], 2],
        ['Um texto diz que o parque "é um lugar importante". Só com isso, pode afirmar o tamanho?', ['Não, não se sabe', 'Só com um mapa', 'Sim, é grande', 'Sim, é pequeno'], 0],
        ['Num texto, "o autor propõe" indica que:', ['É uma citação', 'É uma opinião ou sugestão', 'É uma conclusão automática', 'É um dado comprovado'], 1],
        ['Leia: "Apesar da alta do preço, a demanda caiu." Isto é:', ['Uma citação', 'Uma relação esperada', 'Uma descrição', 'Uma coincidência'], 1],
      ],
      science: [
        ['Qual afirmação descreve melhor o efeito do sal no gelo?', ['Baixa o ponto de congelamento e o derrete', 'Endurece', 'Seca', 'Aquece'], 0],
        ['Uma planta cresce em direção à luz. Esse comportamento chama-se:', ['Hidrotropismo', 'Quimiotropismo', 'Fototropismo', 'Geotropismo'], 2],
        ['Ao submergir um corpo em água, os objetos mais densos afundam porque:', ['Têm mais massa', 'São sempre mais pesados', 'O peso supera o empuxo', 'São maiores'], 2],
        ['A energia que move um moinho de vento é:', ['Energia cinética', 'Energia química', 'Energia nuclear', 'Energia elétrica'], 0],
        ['Exemplo de mudança física é:', ['O gelo derretendo', 'O ferro enferrujando', 'A comida digerindo', 'A madeira queimando'], 0],
      ],
    },
