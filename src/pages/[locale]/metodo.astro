};

const texts = textDict[locale as string] || textDict['en'];

/** Fuentes oficiales de cada afirmacion, para que se puedan comprobar. */
const SOURCES = [
  { label: 'PISA 2022 Mathematics Framework (OCDE)', href: 'https://pisa2022-maths.oecd.org/' },
  { label: 'PISA 2022 Assessment and Analytical Framework (OCDE)', href: 'https://www.oecd.org/en/publications/pisa-2022-assessment-and-analytical-framework_ac1d1f2b-en.html' },
  { label: 'PISA Released Units (OCDE)', href: 'https://pisa2022-questions.oecd.org/' },
  { label: 'PISA 2022 Results Vol. I (OCDE)', href: 'https://www.oecd.org/en/publications/pisa-2022-results-volume-i_2ef9f27e-en.html' }
];
---

<Layout title={texts.title} locale={routeLocale(locale)} current="metodo" alternates={buildAlternates({ path: 'metodo', locale, site: Astro.site })}>
  <div class="wrap">
    <h1 class="title">{texts.title} <Badge variant="info">{texts.badge}</Badge></h1>
    <p class="sub">{texts.description}</p>

    <section aria-labelledby="s-what">
      <h2 id="s-what">{texts.whatTitle}</h2>
      <p class="body">{texts.whatBody}</p>
      <div class="grid3">
        <Card variant="surface" padding="md">
          <h3>{texts.whatS1}</h3>
          <p class="body sm">{texts.whatS1d}</p>
        </Card>
        <Card variant="surface" padding="md">
          <h3>{texts.whatS2}</h3>
          <p class="body sm">{texts.whatS2d}</p>
        </Card>
        <Card variant="surface" padding="md">
          <h3>{texts.whatS3}</h3>
          <p class="body sm">{texts.whatS3d}</p>
        </Card>
      </div>
    </section>

    <section aria-labelledby="s-frameworks">
      <h2 id="s-frameworks">{texts.frameworksTitle}</h2>
      <p class="body">{texts.frameworksNote}</p>

      <Card variant="elevated" padding="lg">
        <h3>{texts.mathTitle}</h3>
        <dl class="defs">
          <dt>{texts.mathProcess1}</dt><dd>{texts.mathProcess1d}</dd>
          <dt>{texts.mathProcess2}</dt><dd>{texts.mathProcess2d}</dd>
          <dt>{texts.mathProcess3}</dt><dd>{texts.mathProcess3d}</dd>
        </dl>
        <dl class="defs">
          <dt>{texts.mathContent}</dt><dd>{texts.mathContentValue}</dd>
          <dt>{texts.mathContexts}</dt><dd>{texts.mathContextsValue}</dd>
        </dl>
        <p class="note">{texts.mathContextsNote}</p>
      </Card>

      <Card variant="elevated" padding="lg">
        <h3>{texts.readingTitle}</h3>
        <p class="body">{texts.readingBody}</p>
        <p class="note">{texts.readingNote}</p>
      </Card>

      <Card variant="elevated" padding="lg">
        <h3>{texts.scienceTitle}</h3>
        <p class="body">{texts.scienceBody}</p>
        <p class="note">{texts.scienceNote}</p>
      </Card>
    </section>

    <section aria-labelledby="s-levels">
      <h2 id="s-levels">{texts.levelsTitle}</h2>
      <p class="body">{texts.levelsBody}</p>
      <p class="note">{texts.levelsNote}</p>
