    colData: 'Colombia (COL): Mathematics 383, Reading 409, Science 411.',
    ocdeData: 'OECD average: 472 / 476 / 485.',
    sgpData: 'Singapore (SGP): 575 / 543 / 561.',

    sourcesTitle: 'Sources',
    disclaimer:
      'UNOFFICIAL educational content, no OECD affiliation. The figures come from PISA 2022 Results Vol I. Frameworks are cited with their official source.'
  },

  pt: {
    title: 'Método PISAStyle',
    description:
      'O que o PISA mede, como cada item é construído e como uma unidade é calibrada. Com as fontes da OCDE.',
