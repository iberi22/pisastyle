---
import Layout from '../../layouts/Layout.astro';
import { Card, Badge } from '@swal/ui';
import { buildAlternates, routeLocale } from '../../lib/alternates';
import { isPisaLocale } from '../../lib/pisa-i18n';

// SIN `export const prerender = true` a proposito.
//
// Se probo y rompio: /es/metodo, /en/metodo y /pt/metodo devolvian 500 en
// `astro dev` mientras las otras dos paginas (que no lo tienen) respondian 200.
// En `output: 'server'` con el adaptador de Cloudflare, Astro 7 NO ejecuta el
// prerender handler en dev (vite-plugin-astro-server/plugin.js solo lo usa si
// el entorno 'prerender' es runnable), asi que la ruta se cae.
//
// El build de produccion si prerenderiza y el HTML resultante es correcto,
// pero un 500 en dev hace imposible trabajar en la pagina. Todo SSR es
// coherente con las otras dos rutas, asi que la opcion segura es quitarlo. Si
// alguna vez hace falta prerenderizar esta pagina, hay que hacerlo por build,
// no por dev."""

export function getStaticPaths() {
  return [
    { params: { locale: 'es' } },
    { params: { locale: 'en' } },
    { params: { locale: 'pt' } }
  ];
}

const { locale } = Astro.params;

// Un primer segmento que no es locale NO es una ruta del sitio: `[locale]`
// hace match con cualquier cosa y la pagina se serviria con la locale por
// defecto bajo una URL canonica inexistente. Un 200 falso es peor que un 404.
if (!isPisaLocale(locale)) {
  return Astro.redirect('/404');
}

/**
 * El contenido vive en un diccionario por locale, no en un JSON aparte, porque
 * las secciones se enumeran en el markup: anadir una seccion obliga a tocar el
 * texto de los tres idiomas a la vez, que es justo lo que evita que queden
 * descuadradas.
 *
 * `src` es la fuente de cada afirmacion. Todo lo que no viene de la OCDE esta
 * marcado como propio, para no dar a entender que es oficial.
 */
const textDict: Record<string, any> = {
  es: {
    title: 'Método PISAStyle',
    description:
      'Qué mide PISA, cómo está construido cada ítem y cómo se calibra una unidad. Con las fuentes de la OCDE.',
    badge: 'v1.1',

    whatTitle: 'Qué es PISA',
    whatBody:
      'PISA es el Programa para la Evaluación Internacional de Estudiantes de la OCDE. Mide lo que alumnos de unos 15 años saben aplicar en contextos reales, no lo que memorizan. Se aplica cada tres años, por ordenador en la mayoría de países, y no es un examen de la OCDE: es una evaluación diagnóstica comparada entre países.',
    whatS1: 'Mide competencia, no currículo',
    whatS1d:
      'Las preguntas no preguntan por una fórmula concreta sino por resolver un problema formulado en la vida real. Por eso la misma destreza puede aparecer en un entorno doméstico o de política pública.',
    whatS2: 'Cíclico y comparable',
    whatS2d:
      'Cada ronda permite comparar con las anteriores porque el marco se mantiene estable. Las puntuaciones se leen sobre una escala con media 500 y desviación 100, no como un porcentaje.',
    whatS3: 'Aportado por los países',
    whatS3d:
      'Los ítems los desarrollan equipos de expertos de los propios países participantes, no la OCDE en solitario. Eso es lo que hace comparables los resultados entre sistemas distintos.',

    frameworksTitle: 'Los tres marcos de dominio',
    frameworksNote:
      'Cada dominio evalúa con procesos distintos. Conocerlos es lo que evita el error más común: practicar solo el de matemáticas.',

    mathTitle: 'Matemáticas',
    mathProcesses: 'Procesos',
    mathProcess1: 'Formular',
    mathProcess1d:
      'Traducir un problema del mundo real al lenguaje matemático: detectar qué matemáticas hay en él y darle estructura.',
    mathProcess2: 'Emplear',
    mathProcess2d:
      'Aplicar conceptos, hechos, procedimientos y razonamiento sobre un problema ya formulado para llegar a una conclusión.',
    mathProcess3: 'Interpretar y evaluar',
    mathProcess3d:
      'Volver al contexto original: comprobar si el resultado es razonable y si tiene sentido en el mundo real.',
    mathContent: 'Contenidos',
    mathContentValue:
      'Cantidad · Incertidumbre · Cambio y relaciones · Patrones. Dos ítems suelen ir sobre modelización matemática, el corazón del razonamiento.',
    mathContexts: 'Contextos',
    mathContextsValue: 'Personal · Social · Global · Académico',
    mathContextsNote:
      'La mayoría de los ítems released usan el contexto personal: dinero del día a día, transporte, unplanned household tasks.',

    readingTitle: 'Lectura',
    readingBody:
      'El marco de lectura organiza la comprensión en tres vertentes amplias: localizar información, comprender el texto e inferir, y reflexionar y evaluar sobre lo que se ha leído. Cada texto pide algo distinto y la dificultad crece cuando hay que sostener una inferencia más de una frase.',
    readingNote:
      'Los ítems released de PISA 2018 que usamos como ancla están en CR551, CR548, CR557 y CR571. Fíjate en el estilo: preguntas que obligan a volver al texto más de una vez.',

    scienceTitle: 'Ciencias',
    scienceBody:
      'La ciencia se evalúa con tres competencias: explicar fenómenos científicamente, interpretar y evaluar datos y evidencia, y producir o evaluar el conocimiento científico. La competencia central es razonar con evidencia, no memorizar datos.',
    scienceNote:
      'En sciences no hay unidades liberadas oficiales de PISA: el ancla se toma del contexto matemático que sostiene el razonamiento, y por eso el dominio aparece marcado como tal en el validador.',

    levelsTitle: 'Niveles de desempeño',
    levelsBody:
      'PISA agrupa el desempeño en seis niveles, del 1c al 6. El nivel 2 es el umbral de competencia: por debajo no se considera que el alumno aplique matemáticas, lectura o ciencias con soltura. La escala oficial no arranca en cero, así que un 400 no es "casi cero": es un nivel bajo pero por encima del mínimo.',
    levelsNote:
      'Nuestro autoexamen de /evaluar devuelve una estimación orientativa en esa escala. No es comparable con un resultado oficial de PISA.',

    methodTitle: 'El método PISAStyle v1.1',
    methodBody:
      'Cada unidad tiene tres partes: un estímulo que sitúa el problema, un bloque de estudio de una a dos horas y una evaluación. Cada ítem lleva ocho campos obligatorios del protocolo v1.1 —dominio, proceso, contenido, contexto, formato, demanda, nivel y ancla— y la explicación de por qué la clave es esa y no otra.',
    methodStep1: 'Estímulo',
    methodStep1d: 'El texto o situación que da contexto. Tiene que ser de la vida real, no un ejercicio abstracto.',
    methodStep2: 'Estudio de 1–2 h',
    methodStep2d:
      'Trabajo dirigido con los conceptos y las destrezas que el estímulo exige. Es la parte que más gente se salta y la que más pesa en el resultado.',
    methodStep3: 'Evaluación',
    methodStep3d:
      'Ítems etiquetados por dominio y nivel, con explicación de cada distractor. Al final obtienes una estimación de nivel.',

    qualityTitle: 'Calidad y límites',
    qualityBody:
      'Nuestro validador exige que todo ítem lleve los ocho campos del protocolo, una explicación de al menos 80 caracteres y una fuente citada, y rechaza duplicados, sesgo de letra y patrones predecibles. Es un filtro de forma, no de calidad: decide si un ítem está bien escrito, no si es pedagógicamente bueno. Ese juicio sigue siendo de una persona.',
    whatNotTitle: 'Qué no es PISAStyle',
    whatNot1: 'No es una evaluación oficial',
    whatNot1d: 'No la realiza la OCDE, no tiene su certificación y sus resultados no son comparables con PISA.',
    whatNot2: 'Sin afiliación',
    whatNot2d: 'PISA® es una marca de la OCDE. Este contenido es educativo y no oficial.',
    whatNot3: 'Las unidades de estímulo y estudio son privadas',
    whatNot3d:
      'Viven en un almacén privado del laboratorio y no forman parte del repositorio público. El banco de ítems sí es público.',

    evaluateTitle: 'Empieza por aquí',
    evaluateBody:
      'Si no sabes por dónde arrancar, mide tu nivel: quince preguntas orientativas, cinco por dominio, en tres minutos. Te dice qué dominio que conviene reforzar antes de la primera unidad.',
    ctaEvaluate: 'Evalúa tu nivel',
    ctaExplore: 'Ver una unidad',
    ctaContribute: 'Corrige un ítem',

    dataTitle: 'Datos de referencia, PISA 2022',
    dataNote:
      'Puntuaciones medias en la escala oficial. La OCDE publica el puesto por rangos y por dominio, no como un número único sobre 81: por eso aquí no damos un puesto exacto.',
    colData: 'Colombia (COL): Matemáticas 383, Lectura 409, Ciencias 411.',
    ocdeData: 'Promedio OCDE: 472 / 476 / 485.',
    sgpData: 'Singapur (SGP): 575 / 543 / 561.',

    sourcesTitle: 'Fuentes',
    disclaimer:
      'Contenido educativo NO OFICIAL, sin afiliación con la OCDE. Las cifras proceden de PISA 2022 Results Vol I. Los marcos se citan con su fuente oficial.'
  },

  en: {
    title: 'PISAStyle Method',
    description:
