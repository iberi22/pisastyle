---
/**
 * /[locale]/contribuir — propuesta de correccion o item nuevo, SIN LOGIN.
 *
 * Por que una pagina y no un boton suelto en el pie: la propuesta de un item
 * exige 14 campos (enunciado, opciones, explicacion y los 8 del protocolo v1.1
 * §2) y el visitante necesita ver el formato de cada uno mientras escribe. En
 * un modal no cabe, y una issue en blanco tampoco dice que se espera.
 *
 * decision de producto, repetida porque es la restriction dura: la entrega es
 * un enlace a `github.com/iberi22/pisastyle/issues/new` con el titulo y el
 * cuerpo ya escritos, NO una llamada a la API. En un sitio estatico un token de
 * GitHub solo puede vivir en el bundle del navegador, y ahi es publico. Ver el
 * razonamiento completo en src/lib/contrib-issue.ts.
 *
 * `current="contribuir"` marca el enlace activo en SiteNav y hace que el
 * selector de idioma apunte a /es/contribuir, /en/contribuir, /pt/contribuir.
 * Sin `export const prerender = true` a proposito: ver el comentario de
 * metodo.astro sobre por que eso rompe el dev server con el adaptador de
 * Cloudflare.
 */
import Layout from '../../layouts/Layout.astro';
import ContribForm from '../../components/ContribForm.svelte';
import { buildAlternates, routeLocale } from '../../lib/alternates';
import { CONTRIB_REPO_OWNER, CONTRIB_REPO_NAME } from '../../lib/contrib-issue';

import es from '../../data/contribuir.es.json';
import en from '../../data/contribuir.en.json';
import pt from '../../data/contribuir.pt.json';

export function getStaticPaths() {
  return [
    { params: { locale: 'es' } },
    { params: { locale: 'en' } },
    { params: { locale: 'pt' } },
  ];
}

const { locale } = Astro.params;
const loc = routeLocale(locale);

type Copy = typeof es;
const COPY: Record<'es' | 'en' | 'pt', Copy> = {
  es: es as Copy,
  en: en as Copy,
  pt: pt as Copy,
};

const text = COPY[loc] ?? COPY.en;

/**
 * Rotulos de la issue en el idioma del visitante. El equipo revisa en las tres
 * languages, asi que el cuerpo llega ya traducido y no hay que adivinar de que
 * idioma viene.
 */
const ISSUE_LABELS = {
  es: {
    types: { correction: 'corrección', new: 'ítem nuevo' },
    fields: {
      domain: 'Dominio',
      process: 'Proceso',
      content: 'Contenido',
      context: 'Contexto',
      format: 'Formato',
      demand: 'Demanda',
      level: 'Nivel',
      anchor: 'Ancla',
    },
    optionsHeader: 'Opciones',
    explanationHeader: 'Explicación de la respuesta correcta',
    noteHeader: 'Nota',
    unitHeader: 'Unidad o ítem afectado',
    protocolHeader: 'Etiquetado del protocolo',
    stemHeader: 'Enunciado',
    generatedBy: 'Generado por la página /contribuir de PISAStyle. Sin login, sin cookies y sin datos personales.',
    noDataNotice:
      'Este cuerpo no contiene ningún dato personal: quien lo envía puede estar o no autenticado en GitHub, es decisión suya.',
  },
  en: {
    types: { correction: 'correction', new: 'new item' },
    fields: {
      domain: 'Domain',
      process: 'Process',
      content: 'Content',
      context: 'Context',
      format: 'Format',
      demand: 'Demand',
      level: 'Level',
      anchor: 'Anchor',
    },
    optionsHeader: 'Options',
    explanationHeader: 'Explanation of the correct answer',
    noteHeader: 'Note',
    unitHeader: 'Affected unit or item',
    protocolHeader: 'Protocol tagging',
    stemHeader: 'Stem',
    generatedBy: 'Generated by the PISAStyle /contribuir page. No login, no cookies, no personal data.',
    noDataNotice:
      'This body contains no personal data: whether the sender is signed in to GitHub is their own choice.',
  },
  pt: {
    types: { correction: 'correção', new: 'item novo' },
    fields: {
      domain: 'Domínio',
      process: 'Processo',
      content: 'Conteúdo',
      context: 'Contexto',
      format: 'Formato',
      demand: 'Demanda',
      level: 'Nível',
      anchor: 'Âncora',
    },
    optionsHeader: 'Opções',
    explanationHeader: 'Explicação da resposta correta',
    noteHeader: 'Nota',
    unitHeader: 'Unidade ou item afetado',
    protocolHeader: 'Etiquetagem do protocolo',
    stemHeader: 'Enunciado',
    generatedBy: 'Gerado pela página /contribuir do PISAStyle. Sem login, sem cookies e sem dados pessoais.',
    noDataNotice:
      'Este corpo não contém nenhum dado pessoal: se quem envia está autenticado no GitHub ou não, é decisão dele.',
  },
} as const;
---

<Layout
  title={text.meta.title}
  description={text.meta.description}
  locale={loc}
  current="contribuir"
  alternates={buildAlternates({ path: 'contribuir', locale, site: Astro.site })}
>
  <main class="wrap">
    <header class="head">
      <h1>{text.hero.title}</h1>
      <p class="lead">{text.hero.lead}</p>
      <p class="badge">{text.hero.privacyBadge}</p>
      <p class="privacy">{text.hero.privacyNote}</p>
    </header>

    <section class="flow" aria-labelledby="flow-title">
      <h2 id="flow-title">{text.flow.title}</h2>
      <ol>
        {
          text.flow.steps.map((step, i) => (
            <li>
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="flow-note">{text.flow.note}</p>
    </section>

    {/* Sin un <h2> visible aqui: el propio formulario trae su encabezado y
        dos h2 seguidos con el mismo texto se leen como un error de estructura
        en el indice de la pagina. */}
    <section class="panel">
      <ContribForm
        client:load
        locale={loc}
        copy={text.form}
        messages={text.messages}
        issueLabels={ISSUE_LABELS[loc]}
        repoLabel={`${CONTRIB_REPO_OWNER}/${CONTRIB_REPO_NAME}`}
      />
    </section>
  </main>
</Layout>

<style>
  .wrap { max-width: 860px; margin: 0 auto; padding: 2rem 1rem 4rem; display: flex; flex-direction: column; gap: 2rem; }
  h1 { font-size: 2rem; font-weight: 800; color: var(--swal-text); letter-spacing: -0.02em; }
  .lead { color: var(--swal-text-secondary); line-height: 1.65; margin-top: 0.75rem; max-width: 62ch; }
  .badge {
    display: inline-block; margin-top: 1rem; padding: 0.3rem 0.7rem; border-radius: 999px;
    border: 1px solid var(--swal-border); background: var(--swal-surface);
    font-size: 0.8rem; font-weight: 600; color: var(--swal-text);
  }
  .privacy { font-size: 0.82rem; color: var(--swal-text-muted); margin-top: 0.5rem; line-height: 1.5; max-width: 62ch; }
  .flow { border-top: 1px solid var(--swal-border); padding-top: 1.5rem; }
  .flow h2 { font-size: 1.15rem; font-weight: 700; color: var(--swal-text); margin-bottom: 1rem; }
  /* El <ol> se mantiene porque aporta la semantica de lista ordenada a un
     lector de pantalla, que es justo lo que unos "div con numeros" no darian,
     pero su marcador decimal se oculta: cada paso lleva ya su circulo numerado
     y sin esto se leia "1. 1" en cada linea (medido en navegador).
     `.flow` va como ancestro, no como clase del propio <ol>: el <ol> no la
     tiene, y por eso esta regla no aplicaba durante un tiempo. */
  .flow ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .flow li { display: flex; gap: 0.85rem; align-items: flex-start; }
  .step-num {
    flex: 0 0 1.75rem; height: 1.75rem; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px; background: var(--swal-accent-muted); color: var(--swal-text);
    font-weight: 700; font-size: 0.85rem;
  }
  .flow h3 { font-size: 0.98rem; font-weight: 700; color: var(--swal-text); margin: 0 0 0.2rem; }
  .flow p { font-size: 0.88rem; color: var(--swal-text-secondary); line-height: 1.55; margin: 0; }
  .flow-note { margin-top: 1.25rem; font-size: 0.82rem; color: var(--swal-text-secondary); }
  .panel { border: 1px solid var(--swal-border); border-radius: 10px; padding: 1.5rem; background: var(--swal-surface); }
  @media (max-width: 640px) { .panel { padding: 1rem; } h1 { font-size: 1.6rem; } }
</style>
