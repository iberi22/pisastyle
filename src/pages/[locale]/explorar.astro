---
import Layout from '../../layouts/Layout.astro';
import { Card, Badge } from '@swal/ui';
import { buildAlternates, routeLocale } from '../../lib/alternates';
import RankingBars from '../../components/RankingBars.astro';
import { landingCtas, LANDING_TAGLINE } from '../../lib/landing';
import { loadUnit } from '../../lib/units';
import { isPisaLocale } from '../../lib/pisa-i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'es' } },
    { params: { locale: 'en' } },
    { params: { locale: 'pt' } }
  ];
}

const { locale } = Astro.params;

// Un primer segmento que no es locale NO es una ruta del sitio. Sin esta
// comprobacion, `[locale]` hace match con cualquier cosa (/no-existe, /xx) y
// los datos de la pagina quedan undefined: 500 al leerlos, o 200 con el
// contenido de la locale por defecto bajo una URL canonica que no existe.
if (!isPisaLocale(locale)) {
  return Astro.redirect('/404');
}

const faqModules = import.meta.glob('../../data/faq.*.json', { eager: true });
const homeModules = import.meta.glob('../../data/home.*.json', { eager: true });

/* La infografia ranking-bars va AQUI y no en [locale]/index.astro: el
   middleware redirige `/` y `/{locale}` a `/{locale}/explorar`
   (src/middleware.ts:68), asi que index.astro es inalcanzable — montado ahi el
   grafico no se veria nunca. Verificado con 302 en / y /es. */
const homeRaw = homeModules[`../../data/home.${locale}.json`] as { default: any } | undefined;
const stats = homeRaw?.default?.stats ?? null;

// Las unidades no se leen con un glob sobre src/data/: no existen ahi (LICENSE.md
// punto 2 las declara privadas y viven en el vault). Ese glob vacio era la causa
// de que las tres locales mostraran "Unidad no disponible".
// Ver src/lib/units.ts para el por que de import.meta.glob y no readFileSync.
const { data: unitData, origin: unitOrigin } = loadUnit(routeLocale(locale));
const faqData = faqModules[`../../data/faq.${locale}.json`]
  ? (faqModules[`../../data/faq.${locale}.json`] as any).default
  : [];

const t = {
  es: {
    explore: "Explorar Unidad PISA",
    stimulus: "Estímulo",
    study: "Contenido de Estudio",
    items: "Ítems",
    faq: "Preguntas Frecuentes",
    actions: "Acciones principales",
    no_unit: "Unidad no disponible en este idioma.",
    process: { interpret: "Interpretar", apply: "Aplicar", reason: "Razonar", explain: "Explicar", evaluate: "Evaluar" },
    level: "Nivel",
    vault_notice: "Contenido de Private Vault, el almacén privado del laboratorio. No forma parte del repositorio público.",
    minutes: "minutos",
    sources: "Fuentes: OECD PISA 2022 Results: COL 383/409/411 puesto 64/81, OCDE 472/476/485, SGP 575/543/561. Contenido ORIGINAL tipo PISA no oficial, sin afiliación OECD."
  },
  en: {
    explore: "Explore PISA Unit",
    stimulus: "Stimulus",
    study: "Study Content",
    items: "Items",
    faq: "FAQ",
    actions: "Primary actions",
    no_unit: "Unit not available in this language.",
    process: { interpret: "Interpret", apply: "Apply", reason: "Reason", explain: "Explain", evaluate: "Evaluate" },
    level: "Level",
    vault_notice: "Content from Private Vault, the laboratory's private store. It is not part of the public repository.",
    minutes: "minutes",
    sources: "Sources: OECD PISA 2022 Results: COL 383/409/411 rank 64/81, OECD 472/476/485, SGP 575/543/561. ORIGINAL unofficial PISA-style content, no OECD affiliation."
  },
  pt: {
    explore: "Explorar Unidade PISA",
    stimulus: "Estímulo",
    study: "Conteúdo de Estudo",
    items: "Itens",
    faq: "Perguntas Frequentes",
    actions: "Ações principais",
    no_unit: "Unidade não disponível neste idioma.",
    process: { interpret: "Interpretar", apply: "Aplicar", reason: "Raciocinar", explain: "Explicar", evaluate: "Avaliar" },
    level: "Nível",
    vault_notice: "Conteúdo do Private Vault, o repositório privado do laboratório. Não faz parte do repositório público.",
    minutes: "minutos",
    sources: "Fontes: Resultados OCDE PISA 2022: COL 383/409/411 posição 64/81, OCDE 472/476/485, SGP 575/543/561. Conteúdo ORIGINAL tipo PISA não oficial, sem afiliação à OCDE."
  }
}[locale as 'es' | 'en' | 'pt'];
---

<Layout title={t.explore} locale={routeLocale(locale)} current="explorar" alternates={buildAlternates({ path: 'explorar', locale, site: Astro.site })}>
  <div class="wrap">
      {/* La landing es DONDE aterriza el visitante (el middleware manda / y
          /{locale} aqui), asi que un <h1> suelto no basta: hace falta por donde
          empezar. Los CTAs vienen de src/lib/landing.ts, que garantiza href
          real y locale correcto; landing.test.ts lo comprueba. */}
      <div class="hero">
        <h1 class="title">{t.explore}</h1>
        <p class="sub">{LANDING_TAGLINE[routeLocale(locale)]}</p>
        <nav class="actions" aria-label={t.actions}>
          {landingCtas(routeLocale(locale)).map((cta) => (
            <a
              class:list={['cta', cta.primary ? 'cta--primary' : null]}
              href={cta.href}
            >
              {cta.label}
            </a>
          ))}
        </nav>
      </div>

    {unitData && unitOrigin === 'vault' && <p class="origin-note">{t.vault_notice}</p>}

    {unitData ? (
      <div class="grid">
        <Card variant="surface" padding="lg">
          <h2>{t.stimulus}</h2>
          <h3>{unitData.stimulus.title}</h3>
          <p class="whitespace-pre-wrap">{unitData.stimulus.content}</p>
        </Card>

        <Card variant="surface" padding="lg">
          <h2>{t.study}</h2>
          <p><strong>Tiempo:</strong> {unitData.study_content.length_minutes} {t.minutes}</p>
          <p>{unitData.study_content.theory}</p>
        </Card>

        <Card variant="surface" padding="lg">
          <h2>{t.items}</h2>
          <div class="items-list">
            {unitData.items.map((item: any) => (
              <div class="item">
                <Badge variant="info">{t.process[item.process as keyof typeof t.process] ?? item.process}</Badge>
                <Badge variant="neutral"><span class="level-tag">{t.level}&nbsp;{item.level}</span></Badge>
                <p><strong>{item.question}</strong></p>
                {(item.options) ? (
                  <ul>
                    {item.options.map((opt: any) => (
                      <li>{opt.id}: {opt.text}</li>
                    ))}
                  </ul>
                ) : null}
              </div>
            ))}
          </div>
        </Card>
      </div>
    ) : (
      <p>{t.no_unit}</p>
    )}

    {stats && (
      <section class="rank-section">
        <RankingBars
          colombia={{ math: stats.colombia.math, reading: stats.colombia.reading, science: stats.colombia.science }}
          oecd={stats.oecd}
          singapore={stats.singapore}
          labels={stats.labels}
          regionLabels={stats.labels}
          locale={routeLocale(locale)}
        />
      </section>
    )}

    <div class="faq-section">
      <h2>{t.faq}</h2>
      <div class="faq-grid">
        {faqData.map((faq: any) => (
          <Card variant="surface" padding="md">
            <h4>{faq.q}</h4>
            <p>{faq.a}</p>
          </Card>
        ))}
      </div>
    </div>

    <footer class="footer">
      <p class="disclaimer">{t.sources}</p>
    </footer>
  </div>
</Layout>

<style>
  .wrap { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; display: grid; gap: 2rem; }
  .title { font-size: 1.8rem; font-weight: 800; color: var(--swal-text); }
  .hero { display: grid; gap: 0.9rem; justify-items: start; }
  .sub { margin: 0; color: var(--swal-text-secondary); line-height: 1.6; max-width: 62ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  /* <a> y no <Button> del core: los botones del core con children desde .astro
     salian sin texto (los children no llegan por el barrel), y un boton sin
     href no es un enlace. Un <a> real se navega con teclado, se abre en
     pestana con ctrl y lo sigue el crawler. */
  .cta {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 2.75rem; padding: 0 1.1rem; border-radius: 8px;
    font-weight: 600; font-size: 0.95rem; text-decoration: none;
    border: 1px solid var(--swal-border); color: var(--swal-text);
    background: var(--swal-surface);
  }
  .cta:hover { background: var(--swal-surface-hover); }
  .cta:focus-visible { outline: 2px solid var(--swal-accent); outline-offset: 2px; }
  .cta--primary {
    background: var(--swal-accent); color: var(--swal-accent-contrast, var(--swal-bg));
    border-color: var(--swal-accent);
  }
  .cta--primary:hover { background: var(--swal-accent-hover); }
  .grid { display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .grid { grid-template-columns: 1fr 1fr; } .grid > :last-child { grid-column: span 2; } }
  .whitespace-pre-wrap { white-space: pre-wrap; line-height: 1.6; }
  .items-list { display: flex; flex-direction: column; gap: 1rem; }
  /* Cada item es una tarjeta, no solo un separador: con un unico border-bottom
     los items se leian como una lista continua y no se distinguia donde acaba
     uno. Borde completo + fondo + padding. */
  .item {
    padding: 1rem 1.1rem;
    border: 1px solid var(--swal-border);
    border-radius: 10px;
    background: var(--swal-surface);
  }
  /* El badge de nivel es el de menor contraste del core (neutral). A 11 px era
     ilegible; se sube peso y tamano sin tocar el componente compartido. */
  .item :global(.swal-badge.neutral) { font-weight: 700; font-size: 0.78rem; padding: 3px 9px; }
  /* El texto del nivel va en su propio span: sin el, "Nivel" y el numero salian
     pegados ("Nivel3") porque el espacio en linea normal entre dos hijos de un
     inline-flex se descarta al final de la linea. */
  .level-tag { white-space: nowrap; }
  .faq-section { margin-top: 2rem; }
  .faq-grid { display: grid; gap: 1rem; margin-top: 1rem; }
  h2 { font-size: 1.4rem; font-weight: 700; color: var(--swal-text); margin-bottom: 1rem; }
  h3 { font-size: 1.1rem; font-weight: 600; color: var(--swal-text); margin-bottom: 0.5rem; }
  h4 { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.5rem; }
  .footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--swal-border); text-align: center; }
  .disclaimer { font-size: 0.85rem; color: var(--swal-text-muted); }
  ul { padding-left: 1.5rem; line-height: 1.6; }
</style>
