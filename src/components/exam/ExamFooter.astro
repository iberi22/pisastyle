---
/**
 * ExamFooter — pie fijo de la pantalla de examen.
 *
 * Tres zonas, como en SaberParaTodos: "Reportar" a la izquierda, el contador de
 * posicion en el centro, y la navegacion a la derecha. La diferencia es que
 * aqui "Siguiente" no siempre avanza: en la ultima pregunta pasa a ser
 * "Finalizar", y "Anterior" se deshabilita en la primera en vez de desaparecer.
 * Un boton que aparece y desaparece hace que el pie cambie de ancho entre
 * preguntas y descarta el pulgar del usuario justo cuando va a pulsar.
 *
 * — POR QUE `.astro` Y NO SVELTE —
 * Es markup estatico con tres botones. Hidratarlo seria pagar un bundle para
 * tres `<button>` que el navegador ya sabe manejar. La interactividad llega por
 * `data-exam-action`, igual que en ExamHeader (ver ahi el protocolo).
 *
 * — DESHABILITADO, NO ESCONDIDO —
 * "Anterior" en la primera pregunta queda con `disabled`, no desaparece: el
 * pie mantiene su ancho, la posicion del pulgar no cambia y un lector de
 * pantalla anuncia el boton como deshabilitado en vez de no anunciarlo.
 */
interface Props {
  /** Posicion actual, 1-based. */
  itemNumber: number;
  /** Total de preguntas. */
  totalItems: number;
  /** `false` en la primera pregunta: deshabilita "Anterior". */
  canGoPrev: boolean;
  /** `true` en la ultima: "Siguiente" pasa a "Finalizar". */
  isLast: boolean;
  onPrev: () => void;
  onNext: () => void;
  onReport: () => void;
  /** Textos. El padre los traduce. */
  labels?: Partial<{
    report: string;
    reportHint: string;
    prev: string;
    next: string;
    finish: string;
    position: string;
    progress: string;
    questionOf: string;
  }>;
}

const { itemNumber, totalItems, canGoPrev, isLast, onPrev, onNext, onReport, labels = {} } = Astro.props;

const T = {
  report: 'Reportar',
  reportHint: 'Reportar esta pregunta',
  prev: 'Anterior',
  next: 'Siguiente',
  finish: 'Finalizar',
  position: 'Posicion en el examen',
  progress: 'Progreso del examen',
  questionOf: 'de',
  ...labels,
};

const hasPrev = typeof onPrev === 'function';
const hasNext = typeof onNext === 'function';
const hasReport = typeof onReport === 'function';
---

<footer class="exam-footer" data-handler="exam-footer">
  {
    hasReport && (
      <button
        type="button"
        class="ghost report"
        data-exam-action="onReport"
        aria-label={`${T.reportHint}: ${T.questionOf} ${itemNumber} ${T.position}`}
      >
        <span class="flag" aria-hidden="true">
          {String.fromCharCode(9873)}
        </span>
        {T.report}
      </button>
    )
  }

  <p class="counter" aria-label={`${T.progress}: ${itemNumber} ${T.questionOf} ${totalItems}`}>
    <span class="now">{itemNumber}</span>
    <span class="sep" aria-hidden="true">
      /
    </span>
    <span class="total">{totalItems}</span>
  </p>

  <div class="nav">
    {
      hasPrev && (
        <button
          type="button"
          class="ghost"
          data-exam-action="onPrev"
          disabled={!canGoPrev}
          aria-disabled={!canGoPrev ? 'true' : undefined}
        >
          {T.prev}
        </button>
      )
    }
    {
      hasNext && (
        <button type="button" class="primary" data-exam-action="onNext">
          {isLast ? T.finish : T.next}
        </button>
      )
    }
  </div>
</footer>

<style>
  /* MEDIDO (scripts/verify-swallow-tokens.py, ambos temas):
     --swal-text-secondary sobre --swal-bg  9.65:1 oscuro / 8.33:1 claro
     --swal-text-secondary sobre --swal-surface-hover  14.33:1 / 15.94:1
     --swal-text sobre --swal-surface-hover  14.33:1 / 15.94:1
     --swal-accent-contrast sobre --swal-accent  16.03:1 / 16.64:1
     Sin literales de color. */
  .exam-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding: 0.6rem 0.9rem;
    background: var(--swal-bg);
    border-top: 1px solid var(--swal-border);
  }

  /* 2.75rem = 44px: los tres botones del pie miden eso de alto, sin
     excepciones ni breakpoints. Es el minimo recomendado para dedo en movil
     (WCAG 2.2 §2.5.5) y por encima del 24px del minimo oficial AA. */
  .ghost,
  .primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border-radius: var(--swal-radius-sm);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .ghost {
    border: 1px solid var(--swal-border-strong);
    background: var(--swal-surface);
    color: var(--swal-text-secondary);
  }
  .ghost:hover:not(:disabled) {
    background: var(--swal-surface-hover);
    color: var(--swal-text);
  }

  .primary {
    border: 1px solid var(--swal-accent);
    background: var(--swal-accent);
    color: var(--swal-accent-contrast, var(--swal-text-inverse));
  }
  .primary:hover:not(:disabled) {
    background: var(--swal-accent-hover);
  }

  /* Deshabilitado pero visible: opaco, sin borde de foco y sin cursor. Se
     mantiene el `min-height` para que el pie no cambie de alto al llegar a la
     primera pregunta. */
  :disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .ghost:focus-visible,
  .primary:focus-visible {
    outline: 2px solid var(--swal-accent);
    outline-offset: 2px;
  }
  .primary:focus-visible {
    outline-color: var(--swal-text);
  }

  .report {
    justify-self: start;
    font-weight: 500;
  }
  .flag {
    color: var(--swal-text-muted);
    font-size: 0.95rem;
    line-height: 1;
  }

  .counter {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
    margin: 0;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--swal-text-muted);
  }
  .now {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--swal-text);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    min-width: 0;
  }

  /* Movil: el pie no cabe en una sola fila con "Reportar" + contador + dos
     botones a 44px dentro de 390px. Pasa a dos filas en vez de desbordar:
     arriba Reportar y el contador, abajo la navegacion a ancho completo con
     los dos botones repartidos. Ningun scroll horizontal. */
  @media (max-width: 480px) {
    .exam-footer {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .report {
      justify-self: stretch;
    }
    .counter {
      justify-self: center;
      order: -1;
    }
    .nav {
      justify-content: stretch;
    }
    .nav > * {
      flex: 1;
    }
  }
</style>

<script>
  /* Mismo protocolo de delegacion que ExamHeader y ExamOptions, con su propia
     bandera para no duplicar el listener si los tres se montan juntos. Los
     botones de este pie ya son `<button type="button">` nativos: solo falta
     traducir el clic al callback del padre. */
  const FLAG = '__pisaExamFooter';

  if (!(document as Document & Record<string, unknown>)[FLAG]) {
    (document as Document & Record<string, unknown>)[FLAG] = true;

    document.addEventListener('click', (ev) => {
      const target = (ev.target as HTMLElement | null)?.closest<HTMLButtonElement>(
        'footer[data-handler="exam-footer"] [data-exam-action]'
      );
      if (!target || target.disabled) return;
      const action = target.dataset.examAction;
      if (!action) return;

      const bag = (
        window as unknown as Record<string, Record<string, (d: Record<string, unknown>) => void> | undefined>
      ).__PISASTYLE_EXAM__;
      const fn = bag?.[`exam-footer:${action}`];
      const detail: Record<string, unknown> = { action };
      if (fn) fn(detail);
      else document.dispatchEvent(new CustomEvent('pisa:exam', { detail }));
    });
  }
</script>
